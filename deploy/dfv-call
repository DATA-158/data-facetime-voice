#!/bin/bash
# dfv-call — ask the warm voice service to place the authorized FaceTime Audio
# call. The bridge daemon dials ONLY the configured E.164 (fail-closed).
# Usage: dfv-call [timeout_seconds]   (default 120: the dial itself, ringing,
# and answer detection all happen before the result file appears)
set -u
DIR="$HOME/.facetime-bridge"
TRIGGER="$DIR/outbound.trigger"
RESULT="$DIR/outbound.trigger.result"
TIMEOUT="${1:-120}"
mkdir -p "$DIR"
rm -f "$RESULT"
touch "$TRIGGER"
deadline=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if [ -f "$RESULT" ]; then
    cat "$RESULT"
    exit 0
  fi
  sleep 1
done
echo "TIMEOUT after ${TIMEOUT}s — check: tail -50 ~/Library/Logs/data-facetime-voice/voice_agent.log"
exit 1
