<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- REQUIRED. The only number this service will dial or answer.
		     Without it outbound dialing refuses to run. -->
		<key>FACETIME_BRIDGE_AUTHORIZED_CALLER_E164</key>
		<string>+15550000000</string>
		<!-- Reasoning effort for TOOL turns. Conversational turns run with
		     reasoning off (DFV_REASONING_EFFORT_FAST, default "none") because
		     thinking tokens are emitted before content and are dead air on a
		     call. -->
		<key>DFV_REASONING_EFFORT</key>
		<string>low</string>
		<key>DFV_SILENCE_MS</key>
		<string>700</string>
		<key>GRPC_ENABLE_FORK_SUPPORT</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.data.facetime-voice</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOURUSER/agent-calling/.venv-native-tts/bin/python</string>
		<string>/Users/YOURUSER/Documents/Programming/Datas_Projects/data-facetime-voice/voice_agent.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/YOURUSER/Library/Logs/data-facetime-voice/voice_agent.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOURUSER/Library/Logs/data-facetime-voice/voice_agent.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
